GRIDGUARD_APP_NAME=GridGuard API
GRIDGUARD_APP_VERSION=0.1.0
GRIDGUARD_ENVIRONMENT=development
GRIDGUARD_API_V1_PREFIX=/api/v1
GRIDGUARD_DATABASE_URL=postgresql+psycopg://gridguard:gridguard_dev_password@localhost:5432/gridguard
GRIDGUARD_SESSION_COOKIE_NAME=gridguard_session
GRIDGUARD_SESSION_TTL_DAYS=7
GRIDGUARD_COOKIE_SECURE=false
GRIDGUARD_INVITATION_TTL_DAYS=7